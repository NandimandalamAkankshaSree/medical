# MediAssist AI - Environment Variables

# Optional Google Gemini API Key for LLM-enhanced clinical summaries & Q&A
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT Security
JWT_SECRET=mediassist_ai_super_secret_jwt_key_2026

# Database (Default is local SQLite; can use PostgreSQL, Neon, Supabase for cloud production)
# DATABASE_URL=postgresql://user:password@host:5432/mediassist

# Optional Frontend Custom API URL (If deploying frontend & backend separately)
# VITE_API_URL=https://your-backend-domain.com
